# Build context: repository root (both Dockerfiles share it)
# Dependency trees
**/node_modules

# Build outputs (rebuilt inside the images)
**/dist
**/coverage

# Git
.git
.gitignore
.gitattributes

# IDE
.vscode
.idea
*.swp
*.swo

# Logs
*.log
logs

# Test artifacts and test code (never needed in an image)
coverage
*.spec.ts
*.test.ts
*.test.tsx
test
web/e2e
web/test-results
web/playwright-report

# Environment (never bake secrets; compose provides env_file at runtime)
.env
.env.*

# Database volume and local data
pgdata
data

# Documentation
*.md
!README.md

# Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore
